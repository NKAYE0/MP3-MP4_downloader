<UserControl x:Class="YtTikDownloader.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="StatLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="StatValue">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFAAAAAA"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <!-- Fixed-width card so tiles line up in neat rows instead of each
             stretching to fill whatever space is left in the window. -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Width" Value="150"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="700" HorizontalAlignment="Left">

            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Padding="12,4" Command="{Binding RefreshCommand}"/>
                <TextBlock Text="Download statistics" FontWeight="Bold" FontSize="17" VerticalAlignment="Center"/>
            </DockPanel>

            <WrapPanel Margin="0,16,0,0">
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total downloads" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalDownloads}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Successful" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding SuccessfulDownloads}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Failed" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding FailedDownloads}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Total size on disk" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TotalSizeText}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="By category" Style="{StaticResource SectionHeader}"/>
            <WrapPanel>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="YouTube" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding YouTubeCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TikTok" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding TikTokCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="YouTube Music" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding YouTubeMusicCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="By format" Style="{StaticResource SectionHeader}"/>
            <WrapPanel>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Video (MP4)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding VideoDownloads}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Audio (MP3)" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding AudioDownloads}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="SponsorBlock applied" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding SponsorBlockAppliedCount}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="Last 30 days" Style="{StaticResource StatLabel}"/>
                        <TextBlock Text="{Binding Last30DaysTotal}" Style="{StaticResource StatValue}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
