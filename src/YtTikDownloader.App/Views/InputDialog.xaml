<Window x:Class="YtTikDownloader.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" KeyDown="OnInputBoxKeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="12,4" Margin="0,0,8,0" Click="OnCancelClick"/>
            <Button Content="Save" IsDefault="True" Padding="12,4" Click="OnSaveClick"/>
        </StackPanel>
    </StackPanel>
</Window>
